[Unit]
Description=Sandswap Sandlot (embedded)
After=network-online.target sandswap-network.service
# Wants= (not just After=): ordering alone neither starts the unit nor builds a
# dependency — a disabled/failed oneshot left the sandlot to crash-loop on its
# own "bridge br-sandswap missing" check.
Wants=sandswap-network.service
Wants=network-online.target
ConditionPathExists=/etc/sandswap/sandlot.yaml
ConditionPathExists=/dev/kvm
ConditionPathExists=/dev/vhost-vsock
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=sandlot

# ── Syscall-level hardening (the seccomp layer bare-metal otherwise lacks) ──
# The k8s deployment inherits the pod's seccomp profile; bare-metal had no
# platform layer, and the VMM is spawned with --seccomp log by default
# (v28 per-thread allow-lists in SECCOMP_RET_LOG audit mode; promote to
# "true" once the audit e2e is clean). This kernel filter covers the whole
# chain in the meantime —
# sandlot AND its sandvmm children (filters survive execve; the uid transition
# inside the spawn is not a privilege gain).
#   allow: @system-service (+ @mount, which that group excludes: OverlayFS) —
#          membership verified against systemd-analyze syscall-filter, incl.
#          ioctl/openat2/statx/close_range/epoll_pwait2/futex_waitv/membarrier;
#   deny (wins over the allow list): keyrings, namespaces/pivot_root/chroot,
#          io_uring, userfaultfd, cross-process memory reads. bpf/perf/ptrace/
#          kexec/module loading/settimeofday/reboot are already outside the
#          allow-list.
# SystemCallErrorNumber=EPERM: a missed syscall degrades to a visible EPERM
# instead of a SIGSYS kill, so the rollout is diagnosable; tighten to the
# default (kill) once the deployment drills stay green.
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
# unshare is NOT denied here: the in-process virtio-fs worker calls
# unshare(CLONE_FS) per thread (V-02), and its own seccomp layer pins the flag
# to CLONE_FS. Denying unshare at the unit level would break every VM. The
# dangerous namespace flags are separately denied by RestrictNamespaces=yes
# below, which rejects unshare/clone/setns with any CLONE_NEW* flag while
# allowing the non-namespace CLONE_FS the VMM worker needs.
SystemCallFilter=~@keyring setns pivot_root chroot io_uring_setup io_uring_enter io_uring_register userfaultfd process_vm_readv process_vm_writev
SystemCallErrorNumber=EPERM
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
# The shared group (volumes root, /run/sandswap, logs) is the sandlot user's
# PRIMARY group — no supplementary grant needed for it. kvm is the device
# grant for /dev/kvm + /dev/vhost-vsock. NO sandprov by default: an exec-only
# node must not be able to read the volume-name seed (a leaked seed makes
# every tenant's directory name computable). A MERGED (exec,prov) shape adds
# it with a drop-in:
#   /etc/systemd/system/sandswap-sandlot.service.d/sandprov.conf:
#     [Service]
#     SupplementaryGroups=kvm sandprov sandtmpl
# sandtmpl (template-store metadata group) is always present: the exec role
# reads refs to mount overlays. It stays on every exec instance; sandvmm never
# inherits it (launcher.go spawns with an EXPLICIT list: kvm + the shared
# volume group).
# (No sandswap-group grant: nothing on the host is group-sandswap — the
# gateway's credential store is 0600 and every shared path carries sandlot.)
SupplementaryGroups=kvm sandtmpl
# Resolved service identities (uid/gid numbers only — generated by host
# prep when slots were occupied and resolved; "-" = optional: absent file
# means the compiled contract-pinned defaults apply unchanged).
EnvironmentFile=-/etc/sandswap/identity.env
# Same root-side attestation as the instance template: the service uid cannot
# read bpffs, so ExecStartPre proves the pin and writes the file the sandlot
# checks.
ExecStartPre=+/usr/local/bin/sandswap-vsockguard-attest
ExecStart=/usr/local/bin/sandswap-sandlot -config /etc/sandswap/sandlot.yaml
ExecReload=/bin/kill -SIGHUP $MAINPID
Restart=on-failure
# LimitCORE=0: a crash must never write a core image to disk — this process
# holds credential material in memory (API keys, TLS private keys; the merged
# sandlot also holds the volume seed).
LimitCORE=0
RestartSec=10

# Dedicated-identity model (least-privilege node agent, NOT root, NO sudo —
# still narrower than root daemons like libvirtd/kubelet/containerd, which
# hold every capability implicitly):
#   CAP_NET_ADMIN — TAP creation + bridge attach (netlink)
#   CAP_SYS_ADMIN — host-side OverlayFS mount/umount (overlay-mode sandfs,
#                   in-process syscall.Mount) and re-adopt visibility: the
#                   mounts MUST stay in the host mount namespace, so no
#                   ProtectSystem=/PrivateMounts sandboxing here — a restarted
#                   sandlot re-adopts surviving sandvmm processes and must see
#                   their existing overlay mounts.
#   CAP_SETUID/CAP_SETGID — spawn sandvmm children as the dedicated VMM
#                   identity (uid 987, pinned). The kernel CLEARS every
#                   capability set when the effective uid changes to a
#                   non-matching uid, so these caps (and every other) never
#                   reach the child: sandvmm runs with ZERO capabilities.
#   CAP_KILL      — cross-uid SIGKILL of sandvmm (destroy, failed-launch
#                   cleanup, re-adopt kill paths). After the identity split
#                   same-uid kill is denied by the kernel; without this cap
#                   every teardown path fails.
#   kvm supp grp  — /dev/kvm (0660 root:kvm, stock distro perms)
#   primary group — the shared paths ONLY now: the share root
#                   (sandprov:sandlot 2750, setgid — traverse only; the
#                   volumes INSIDE stay group-rw), /run/sandswap, logs. The
#                   vsock devices
#                   moved to per-OWNER isolation (deploy/udev): /dev/vsock
#                   OWNER=sandlot 0600, /dev/vhost-vsock OWNER=sandvmm 0600 —
#                   each device reachable by exactly one process identity.
# AmbientCapabilities cross execve into the sandvmm spawn too, but the uid
# transition inside the spawn (SysProcAttr.Credential) strips them kernel-
# side. The same privilege set is used by every non-systemd launch path via
# common/sh/runtime.sh ss_service_exec (setpriv).
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_KILL

# KillMode=process: only signal the sandlot main process
# Child sandvmm processes are unaffected, left alive for re-adopt
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

LimitNOFILE=65536
TasksMax=8192
LimitNPROC=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sandswap-sandlot

[Install]
WantedBy=multi-user.target
