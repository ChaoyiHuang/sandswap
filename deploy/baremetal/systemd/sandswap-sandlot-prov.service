[Unit]
Description=Sandswap Sandlot (provision plane — sandfs + template lifecycle)
After=network-online.target
# R3-030: the prov role owns the shared-storage template/volume trees —
# start only once the mount exists (systemd adds no ordering from
# ReadWritePaths, and ignore-if-missing would sandbox the pod WITHOUT the
# share, failing every storage op until a manual restart).
RequiresMountsFor=/mnt/sandswap
Wants=network-online.target
ConditionPathExists=/etc/sandswap/sandlot-prov.yaml
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# The provision identity: the ONLY grant is the sandlot shared group (volumes
# + templates RW through the setgid model). NO capabilities, NO kvm group, NO
# vsock devices — a provision host owes KVM/bridge/vsock nothing, and this
# unit is deliberately the most boring, most hardened one in the fleet.
# Outbound only: it dials a human/unified gateway's :9998 (plain stream
# TLS), never listens.
User=sandprov
# SupplementaryGroups=sandlot is the storage grant (volumes + templates RW
# through the setgid model). The volume-name seed needs NO entry here: it is
# scoped root:sandprov, and sandprov's OWN primary group is the dedicated
# provision group — the same group the merged sandlot units add
# (SupplementaryGroups=sandprov) and the sandvmm identity never carries.
SupplementaryGroups=sandlot sandtmpl
# Resolved service identities (uid/gid numbers only — generated by host
# prep when slots were occupied and resolved; "-" = optional: absent file
# means the compiled contract-pinned defaults apply unchanged).
EnvironmentFile=-/etc/sandswap/identity.env
# Re-assert the prov-plane shape at every start (a stale hand-chown or a shape
# flip must not survive): volumes root + template stores only — the unit runs
# as sandprov, the grant carrier the deployment persisted.
ExecStartPre=+/usr/local/lib/sandswap/apply-prov-ownership
ExecStart=/usr/local/bin/sandswap-sandlot -config /etc/sandswap/sandlot-prov.yaml -roles prov
ExecReload=/bin/kill -SIGHUP $MAINPID
Restart=on-failure
RestartSec=10

# KillMode=process matches the exec-role unit's shape (future children would
# survive for re-adopt); the prov role has no children today.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

# The storage plane needs the shared storage mounts (volumes + templates,
# nosuid,nodev per the storage contract), its log dir, and /run/sandswap for
# the one-sandlot-per-host role lock (and the seed adoption record beside it);
# nothing else is writable. Network egress: the configured gateway(s) + the OCI
# registry — enforceable at the network layer.
#
# Seed injection: the generation files this instance derives volume names from
# may be materialized into a TMPFS path (a oneshot fetcher / an agent) or
# delivered as a systemd credential — see the seed channel section of
# docs/deployment/install-baremetal.md. For the env channel, uncomment:
#   EnvironmentFile=-/etc/sandswap/seed.env      (0600 root)
# LimitCORE=0: a crash must never write a core image containing the seed (the
# process holds it in memory for its whole life).
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/sandswap /var/lib/sandswap /var/log/sandswap -/mnt/sandswap
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536
TasksMax=1024
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sandswap-sandlot-prov

[Install]
WantedBy=multi-user.target
