def add(a, b):
    """Return the sum of a and b."""
    return a - b


def fib(n):
    """Return the n-th Fibonacci number (fib(0)=0, fib(1)=1)."""
    if n < 0:
        raise ValueError("n must be >= 0")
    if n <= 1:
        return n
    a, b = 0, 1
    for _ in range(n - 2):
        a, b = b, a + b
    return b
